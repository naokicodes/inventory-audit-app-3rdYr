# Copy to .env (gitignored) and fill in. Never commit real values.
# Loyverse API access tokens, one per account (Step loyverse-preview-i).
LOYVERSE_SILINGAN_TOKEN=
LOYVERSE_LIKOD_TOKEN=
LOYVERSE_FC_TOKEN=
# Signs the login cookie (Step sign-the-cookie). Any long random text; changing it
# logs everyone out. Empty: a random one at each start, so every restart logs everyone out.
COOKIE_SECRET=
# The one shared password for admin logins (ADR-098). Empty: admins log in without one.
ADMIN_PASSWORD=
